<!doctype html>
<html class="no-js">

<head>
  <title>Search Filter</title>

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="description" content="NSW Service Finder">

  <!-- Public Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap"
    rel="stylesheet">

  <!-- Material Icons -->
  <link
    href="https://fonts.googleapis.com/css?family=Material+Icons|Material+Icons+Outlined|Material+Icons+Two+Tone"
    rel="stylesheet">

  <!-- NSW Design System -->
  <link
    rel="stylesheet"
    href="https://designsystem.nsw.gov.au/docs/css/docs.css">

  <!-- Cookie consent -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.0.1/dist/cookieconsent.css">

  <!-- Highlight.js -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/10.5.0/styles/atom-one-light.min.css">

  <!-- Our custom CSS -->
  <link rel="stylesheet" href="/style.css">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/10.5.0/highlight.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/10.5.0/languages/xml.min.js"></script>
</head>

<body>

<div id="content" class="nsw-container nsw-p-top-sm nsw-p-bottom-lg">

  <!-- Search heading -->
  <div class="nsw-layout">

    <div class="nsw-layout__main">

      <h1>Search</h1>

      <p class="nsw-intro">
        Search and filter NSW government services.
      </p>

      <div class="nsw-m-top-lg">

        <div class="nsw-form__input-group">

          <input
            class="nsw-form__input"
            type="text"
            id="search-input"
            placeholder="Search services">

          <button
            class="nsw-button nsw-button--dark nsw-button--flex"
            type="button"
            id="search-button">
            Search
          </button>

        </div>

      </div>

    </div>

    <div class="nsw-layout__sidebar nsw-layout__sidebar--desktop"></div>

  </div>


  <!-- Filters + Results -->
  <div class="nsw-layout">

    <!-- Filters -->
    <div class="nsw-layout__sidebar">

      <div class="nsw-filters nsw-filters--instant">

        <div class="nsw-filters__wrapper">

          <div class="nsw-filters__title">
            Filters
          </div>

          <div class="nsw-filters__list">

            <div class="nsw-filters__item">

              <div class="nsw-filters__item-content">

                <div class="nsw-form__fieldset">

                  <span class="nsw-form__legend">
                    Categories
                  </span>

                  <input
                    class="nsw-form__checkbox-input"
                    type="checkbox"
                    name="filters-instant-categories"
                    value="Customer Service"
                    id="filters-instant-categories-0-1">

                  <label
                    class="nsw-form__checkbox-label"
                    for="filters-instant-categories-0-1">
                    Customer Service
                  </label>


                  <input
                    class="nsw-form__checkbox-input"
                    type="checkbox"
                    name="filters-instant-categories"
                    value="Communities and Justice"
                    id="filters-instant-categories-1-1">

                  <label
                    class="nsw-form__checkbox-label"
                    for="filters-instant-categories-1-1">
                    Communities and Justice
                  </label>


                  <input
                    class="nsw-form__checkbox-input"
                    type="checkbox"
                    name="filters-instant-categories"
                    value="Education"
                    id="filters-instant-categories-2-1">

                  <label
                    class="nsw-form__checkbox-label"
                    for="filters-instant-categories-2-1">
                    Education
                  </label>


                  <input
                    class="nsw-form__checkbox-input"
                    type="checkbox"
                    name="filters-instant-categories"
                    value="Health"
                    id="filters-instant-categories-3-1">

                  <label
                    class="nsw-form__checkbox-label"
                    for="filters-instant-categories-3-1">
                    Health
                  </label>


                  <input
                    class="nsw-form__checkbox-input"
                    type="checkbox"
                    name="filters-instant-categories"
                    value="Planning"
                    id="filters-instant-categories-4-1">

                  <label
                    class="nsw-form__checkbox-label"
                    for="filters-instant-categories-4-1">
                    Planning
                  </label>

                </div>

              </div>

            </div>

          </div>

          <div class="nsw-filters__cancel">

            <a href="#" id="clear-filters">
              Clear all filters
            </a>

          </div>

        </div>

      </div>

    </div>


    <!-- Results -->
    <div class="nsw-layout__main">

      <!-- Dynamic results count -->
      <div class="nsw-results-bar">

        <div
          class="nsw-results-bar__info"
          id="results-info">
          Loading results...
        </div>

      </div>


      <!-- Dynamic service results -->
      <div
        class="nsw-search-results"
        id="search-results">
      </div>


      <!-- Dynamic pagination -->
      <div
        class="nsw-block"
        id="pagination-container">
      </div>

    </div>

  </div>

</div>


<!-- NSW Design System -->
<script src="https://designsystem.nsw.gov.au/js/main.js"></script>

<script>
  window.NSW.initSite();
</script>

<!-- Other libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/1.3.4/jspdf.min.js"></script>

<script
  src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"
  integrity="sha512-BNaRQhBm58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSKda6FXzoEyYGjTe+vXA=="
  crossorigin="anonymous"
  referrerpolicy="no-referrer">
</script>

<script src="https://designsystem.nsw.gov.au/docs/js/docs.js"></script>

<script>
  hljs.initHighlightingOnLoad();
</script>

<!-- Our custom JavaScript -->
<script src="/script.js"></script>

</body>
</html>